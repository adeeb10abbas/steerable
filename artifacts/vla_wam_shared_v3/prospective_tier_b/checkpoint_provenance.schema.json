{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/adeeb10abbas/steerable/blob/main/artifacts/vla_wam_shared_v3/prospective_tier_b/checkpoint_provenance.schema.json",
  "title": "VLA/WAM checkpoint provenance disclosure",
  "description": "Prospective disclosure schema. Unknown or undisclosed training facts remain explicit strings; they are never encoded as zero, false, or absence.",
  "type": "object",
  "required": [
    "schema_version",
    "model_id",
    "checkpoint_identity",
    "training_episode_multiset",
    "preprocessing",
    "caption_exposure",
    "evidence"
  ],
  "properties": {
    "schema_version": {"const": "vla-wam-shared-v3-checkpoint-provenance-v1"},
    "model_id": {"type": "string", "minLength": 1},
    "checkpoint_identity": {
      "type": "object",
      "required": ["artifact_id", "revision", "content_sha256", "runtime_identity_sha256"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "content_sha256": {"$ref": "#/$defs/sha256OrUnknown"},
        "runtime_identity_sha256": {"$ref": "#/$defs/sha256OrUnknown"},
        "license_or_terms": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "training_episode_multiset": {
      "type": "object",
      "required": ["disclosure_status", "datasets", "sampling_or_duplication_policy"],
      "properties": {
        "disclosure_status": {"enum": ["fully_disclosed", "partially_disclosed", "not_disclosed"]},
        "datasets": {"type": "array", "items": {"$ref": "#/$defs/datasetRecord"}},
        "sampling_or_duplication_policy": {"type": "string", "minLength": 1},
        "episode_count": {"$ref": "#/$defs/nonnegativeIntegerOrUnknown"},
        "trajectory_count": {"$ref": "#/$defs/nonnegativeIntegerOrUnknown"}
      },
      "additionalProperties": true
    },
    "preprocessing": {
      "type": "object",
      "required": ["visual", "language", "action"],
      "properties": {
        "visual": {"type": "string", "minLength": 1},
        "language": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "frame_sampling": {"type": "string", "minLength": 1},
        "camera_selection": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "caption_exposure": {
      "type": "object",
      "required": ["disclosure_status", "left_right_tokens", "exact_probe_sentences", "synthetic_or_recaptioned_language"],
      "properties": {
        "disclosure_status": {"enum": ["audited", "partially_audited", "not_auditable"]},
        "left_right_tokens": {"enum": ["present", "absent", "unknown"]},
        "exact_probe_sentences": {"enum": ["present", "absent", "unknown"]},
        "synthetic_or_recaptioned_language": {"enum": ["present", "absent", "unknown"]},
        "audit_method": {"type": "string", "minLength": 1},
        "matched_examples_sha256": {"$ref": "#/$defs/sha256OrUnknown"}
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path_or_url", "sha256_or_status"],
        "properties": {
          "path_or_url": {"type": "string", "minLength": 1},
          "sha256_or_status": {"$ref": "#/$defs/sha256OrUnknown"}
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "sha256OrUnknown": {
      "oneOf": [
        {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        {"enum": ["unknown", "not_disclosed", "not_applicable"]}
      ]
    },
    "nonnegativeIntegerOrUnknown": {
      "oneOf": [
        {"type": "integer", "minimum": 0},
        {"enum": ["unknown", "not_disclosed"]}
      ]
    },
    "datasetRecord": {
      "type": "object",
      "required": ["dataset_id", "revision", "split", "episode_membership"],
      "properties": {
        "dataset_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "split": {"type": "string", "minLength": 1},
        "episode_membership": {"type": "string", "minLength": 1},
        "episode_manifest_sha256": {"$ref": "#/$defs/sha256OrUnknown"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
