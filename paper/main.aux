\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Reflecting movable-object positions reverses placement advantage.} Left: reflected-minus-control interaction in requested-side depth, with seed-clustered 95\% bootstrap intervals; fractions give seeds with the negative interaction. Right: $\pi _{0.5}$ task completion in the independent reflection cohort. Nano is near a binary ceiling, while DreamZero changes from low control completion to near-ceiling reflected completion; their continuous depth interactions remain the common estimand.}}{5}{figure.3}\protected@file@percent }
\newlabel{fig:reflection}{{3}{5}{\textbf {Reflecting movable-object positions reverses placement advantage.} Left: reflected-minus-control interaction in requested-side depth, with seed-clustered 95\% bootstrap intervals; fractions give seeds with the negative interaction. Right: $\pi _{0.5}$ task completion in the independent reflection cohort. Nano is near a binary ceiling, while DreamZero changes from low control completion to near-ceiling reflected completion; their continuous depth interactions remain the common estimand}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {The directional placement contrast changes across a seven-position reference-object sweep.} Left: mean RIGHT-minus-LEFT requested-side depth with seed-clustered 95\% intervals. Right: frozen task success by requested direction. Each position contains 15 matched seeds; the continuous measure exposes variation that binary success compresses near ceiling.}}{5}{figure.4}\protected@file@percent }
\newlabel{fig:sweep}{{4}{5}{\textbf {The directional placement contrast changes across a seven-position reference-object sweep.} Left: mean RIGHT-minus-LEFT requested-side depth with seed-clustered 95\% intervals. Right: frozen task success by requested direction. Each position contains 15 matched seeds; the continuous measure exposes variation that binary success compresses near ceiling}{figure.4}{}}
