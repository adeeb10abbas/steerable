      "argv": [
        "/usr/bin/python3",
        "-c",
        "import collections\nimport datetime\nimport json\nimport pathlib\nimport sys\n\n\nBASE = pathlib.Path(\n    \"/data/users/ali/vla_wam/raw/wmf_ablation_001_20260912/behavioral/development/D1/D01\"\n)\n\n\ndef read_json(path):\n    if not path.is_file():\n        return None\n    if path.is_symlink():\n        return {\"error\": \"symlink_rejected\", \"path\": str(path)}\n    if path.stat().st_size > 1_000_000:\n        return {\"error\": \"json_size_limit\", \"path\": str(path)}\n    try:\n        return json.loads(path.read_text(encoding=\"utf-8\"))\n    except Exception as error:\n        return {\"error\": type(error).__name__, \"path\": str(path)}\n\n\ndef journal_summary(path):\n    counts = collections.Counter()\n    max_action_step = None\n    max_request_index = None\n    last_kind = None\n    if not path.is_file() or path.is_symlink():\n        return {\n            \"exists\": False,\n            \"event_counts\": {},\n            \"max_action_step\": None,\n            \"max_request_index\": None,\n            \"last_kind\": None,\n        }\n    with path.open(encoding=\"utf-8\") as stream:\n        for line in stream:\n            try:\n                event = json.loads(line)\n            except Exception:\n                continue\n            kind = event.get(\"kind\")\n            counts[kind] += 1\n            last_kind = kind\n            payload = event.get(\"payload\", {})\n            action_step = payload.get(\"action_step\")\n            request_index = payload.get(\"request_index\")\n            if type(action_step) is int:\n                max_action_step = action_step if max_action_step is None else max(max_action_step, action_step)\n            if type(request_index) is int:\n                max_request_index = request_index if max_request_index is None else max(max_request_index, request_index)\n    return {\n        \"exists\": True,\n        \"event_counts\": dict(counts),\n        \"max_action_step\": max_action_step,\n        \"max_request_index\": max_request_index,\n        \"last_kind\": last_kind,\n    }\n\n\noutput = {\n    \"schema_version\": \"wmf-d1-development-readonly-snapshot-v1\",\n    \"at_utc\": datetime.datetime.now(datetime.timezone.utc).isoformat(),\n    \"layout_pair_id\": \"D01\",\n    \"run_id\": \"d1-development-d01-003\",\n    \"coordination\": {},\n    \"server\": {},\n    \"simulator\": {\"cells\": {}},\n    \"science_claim_boundary\": \"Read-only progress snapshot; not a terminal receipt or scientific classification.\",\n}\ncoordination = BASE / \"coordination\" / output[\"run_id\"]\nfor name in (\n    \"server_ready.json\",\n    \"server_lease.json\",\n    \"simulator_claim.json\",\n    \"simulator_lease.json\",\n    \"simulator_terminal.json\",\n):\n    output[\"coordination\"][name] = read_json(coordination / name)\nserver = BASE / \"server_attempts\" / \"d1-development-d01-server-003\"\nfor name in (\"ready.json\", \"failure.json\", \"server_receipt.json\", \"d1_behavioral_server_receipt.json\"):\n    output[\"server\"][name] = read_json(server / name)\noutput[\"server\"][\"request_receipt_count\"] = len(list(server.rglob(\"request_receipt.json\"))) if server.is_dir() else 0\nsimulator = BASE / \"simulator_attempts\" / \"d1-development-d01-simulator-003\"\nfor name in (\n    \"resume.json\",\n    \"technical_failure.json\",\n    \"d1_behavioral_development_receipt.json\",\n    \"execution_prerequisites.json\",\n):\n    output[\"simulator\"][name] = read_json(simulator / name)\ncells = simulator / \"cells\"\nif cells.is_dir():\n    for cell in sorted(cells.iterdir()):\n        if not cell.is_dir() or cell.is_symlink():\n            continue\n        output[\"simulator\"][\"cells\"][cell.name] = {\n            \"cell_receipt\": read_json(cell / \"cell_receipt.json\"),\n            \"technical_failure\": read_json(cell / \"technical_failure.json\"),\n            \"journal\": journal_summary(cell / \"recording\" / \"events.partial.jsonl\"),\n            \"request_receipt_count\": len(list(cell.rglob(\"request_receipt.json\"))),\n        }\n\npublish = pathlib.Path(sys.argv[1]) / \"publish\"\npublish.mkdir(parents=True, exist_ok=True)\ndestination = publish / \"diagnostic.json\"\nwith destination.open(\"x\", encoding=\"utf-8\") as stream:\n    json.dump(output, stream, indent=2, sort_keys=True)\n    stream.write(\"\\n\")\nprint(json.dumps({\"status\": \"snapshot_written\", \"at_utc\": output[\"at_utc\"]}, sort_keys=True))\n",
        "{job_dir}"
